# Copy this file to .env and fill in your own values.
# See README.md > "Configure environment variables" for details on each key.

# Groq-hosted LLM used by the supervisor and specialist agents
GROQ_API_KEY=

# Tavily web-search API, used by the hotel agent
TAVILY_API_KEY=

# AviationStack API, used by the flight agent for airport/airline reference data
AVIATIONSTACK_API_KEY=

# Postgres connection string used by LangGraph's checkpointer for thread state
DATABASE_URL=

# Default origin airport (IATA code) used when a request doesn't specify one
DEFAULT_ORIGIN_IATA=

# Optional: LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACKING=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

# OpenWeather API, used by the weather agent
OPENWEATHER_API_KEY=
